{% comment %}
  Fashion FAQ Section
  File: sections/fashion-faq.liquid
{% endcomment %}

{%- liquid
  assign sid = section.id
-%}

<style>
  #faq-{{ sid }} {
    background: {{ section.settings.bg_color }};
    padding-top: {{ section.settings.padding_top_desktop }}px;
    padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
    box-sizing: border-box;
  }

  #faq-{{ sid }} .faq-container {
    max-width: {{ section.settings.container_width }}px;
    margin: 0 auto;
    padding: 0 20px;
    display: flex;
    align-items: center;
    gap: 50px;
  }

  /* Image Column */
  #faq-{{ sid }} .faq-image-col {
    width: {{ section.settings.image_col_width }}%;
    flex: 0 0 {{ section.settings.image_col_width }}%;
  }

  #faq-{{ sid }} .faq-image-wrap {
    width: 100%;
    height: {{ section.settings.image_height_desktop }}px;
    border-radius: {{ section.settings.image_border_radius }}px;
    overflow: hidden;
    line-height: 0;
    background: #e5ded3;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #faq-{{ sid }} .faq-image-wrap img,
  #faq-{{ sid }} .faq-image-wrap svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  #faq-{{ sid }} .faq-placeholder-svg {
    fill: #a39b8e;
    background: #e5ded3;
    width: 100%;
    height: 100%;
  }

  /* Content Column */
  #faq-{{ sid }} .faq-content-col {
    width: calc(100% - {{ section.settings.image_col_width }}%);
    flex: 1;
  }

  #faq-{{ sid }} .faq-title {
    font-family: var(--font-heading--family, inherit);
    font-size: {{ section.settings.title_size_desktop }}px;
    color: {{ section.settings.title_color }};
    margin: 0 0 10px 0;
    line-height: 1.2;
    font-weight: 700;
  }

  #faq-{{ sid }} .faq-title span {
    color: {{ section.settings.highlight_color }};
  }

  #faq-{{ sid }} .faq-subtitle {
    font-family: var(--font-body--family, inherit);
    font-size: {{ section.settings.subtitle_size_desktop }}px;
    color: {{ section.settings.subtitle_color }};
    margin: 0 0 30px 0;
    line-height: 1.5;
  }

  /* Accordion List */
  #faq-{{ sid }} .faq-accordion-list {
    border-top: 1px solid {{ section.settings.border_color }};
  }

  #faq-{{ sid }} .faq-item {
    border-bottom: 1px solid {{ section.settings.border_color }};
  }

  #faq-{{ sid }} .faq-question {
    width: 100%;
    background: none;
    border: none;
    outline: none;
    padding: 20px 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    text-align: left;
    cursor: pointer;
    font-family: var(--font-heading--family, inherit);
    font-size: {{ section.settings.question_size_desktop }}px;
    font-weight: 600;
    color: {{ section.settings.question_color }};
    transition: color 0.2s ease;
  }

  #faq-{{ sid }} .faq-question:hover {
    color: {{ section.settings.highlight_color }};
  }

  #faq-{{ sid }} .faq-icon {
    font-size: 20px;
    font-weight: 400;
    margin-left: 15px;
    transition: transform 0.3s ease;
    line-height: 1;
    color: {{ section.settings.question_color }};
  }

  #faq-{{ sid }} .faq-item.active .faq-icon {
    transform: rotate(45deg);
  }

  #faq-{{ sid }} .faq-answer {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.35s ease-out, padding 0.35s ease-out;
  }

  #faq-{{ sid }} .faq-answer-inner {
    padding-bottom: 20px;
    font-family: var(--font-body--family, inherit);
    font-size: {{ section.settings.answer_size_desktop }}px;
    color: {{ section.settings.answer_color }};
    line-height: 1.6;
  }

  /* Responsive / Mobile Styles */
  @media (max-width: 767px) {
    #faq-{{ sid }} {
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }

    #faq-{{ sid }} .faq-container {
      flex-direction: column;
      gap: 30px;
      padding: 0 16px;
    }

    #faq-{{ sid }} .faq-image-col,
    #faq-{{ sid }} .faq-content-col {
      width: 100%;
      flex: 1 1 100%;
    }

    #faq-{{ sid }} .faq-image-wrap {
      height: {{ section.settings.image_height_mobile }}px;
    }

    #faq-{{ sid }} .faq-title {
      font-size: {{ section.settings.title_size_mobile }}px;
    }

    #faq-{{ sid }} .faq-subtitle {
      font-size: {{ section.settings.subtitle_size_mobile }}px;
      margin-bottom: 20px;
    }

    #faq-{{ sid }} .faq-question {
      font-size: {{ section.settings.question_size_mobile }}px;
      padding: 16px 0;
    }

    #faq-{{ sid }} .faq-answer-inner {
      font-size: {{ section.settings.answer_size_mobile }}px;
      padding-bottom: 16px;
    }
  }
</style>

<section id="faq-{{ sid }}" class="faq-section">
  <div class="faq-container">
    
    <!-- Left/Side Image -->
    <div class="faq-image-col">
      <div class="faq-image-wrap">
        {% if section.settings.image != blank %}
          <img
            src="{{ section.settings.image | image_url: width: 1000 }}"
            alt="{{ section.settings.image.alt | escape }}"
            loading="lazy"
            width="{{ section.settings.image.width }}"
            height="{{ section.settings.image.height }}"
          >
        {% else %}
          {{ 'collection-1' | placeholder_svg_tag: 'faq-placeholder-svg' }}
        {% endif %}
      </div>
    </div>

    <!-- Right Content & Accordions -->
    <div class="faq-content-col">
      {% if section.settings.title != blank %}
        <h2 class="faq-title">
          {{ section.settings.title }}
          {% if section.settings.highlight_title != blank %}
            <span>{{ section.settings.highlight_title }}</span>
          {% endif %}
        </h2>
      {% endif %}

      {% if section.settings.subtitle != blank %}
        <p class="faq-subtitle">{{ section.settings.subtitle }}</p>
      {% endif %}

      <div class="faq-accordion-list">
        {% for block in section.blocks %}
          {% if block.settings.question != blank %}
            <div class="faq-item" {{ block.shopify_attributes }}>
              <button class="faq-question" type="button" aria-expanded="false">
                <span>{{ block.settings.question }}</span>
                <span class="faq-icon">+</span>
              </button>
              <div class="faq-answer">
                <div class="faq-answer-inner">
                  {{ block.settings.answer }}
                </div>
              </div>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>

  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const faqSection = document.getElementById('faq-{{ sid }}');
    if(!faqSection) return;

    const questions = faqSection.querySelectorAll('.faq-question');

    questions.forEach(question => {
      question.addEventListener('click', function() {
        const item = this.parentElement;
        const answer = item.querySelector('.faq-answer');
        const isActive = item.classList.contains('active');

        // Close all items
        faqSection.querySelectorAll('.faq-item').forEach(i => {
          i.classList.remove('active');
          i.querySelector('.faq-question').setAttribute('aria-expanded', 'false');
          i.querySelector('.faq-answer').style.maxHeight = null;
        });

        // Open current item if not active
        if (!isActive) {
          item.classList.add('active');
          this.setAttribute('aria-expanded', 'true');
          answer.style.maxHeight = answer.scrollHeight + 'px';
        }
      });
    });
  });
</script>

