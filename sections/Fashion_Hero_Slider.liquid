{% schema %}
{
  "name": "Fashion Hero Slider",
  "tag": "section",
  "class": "section-fashion-hero-slider",
  "settings": [
    {
      "type": "header",
      "content": "Layout Controls"
    },
    {
      "type": "range",
      "id": "content_max_width",
      "min": 800,
      "max": 1800,
      "step": 20,
      "unit": "px",
      "label": "Max Content Width",
      "default": 1400
    },
    {
      "type": "header",
      "content": "Text & Button Colors"
    },
    {
      "type": "color",
      "id": "subtitle_color",
      "label": "Subtitle Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "desc_color",
      "label": "Description Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "btn_bg_color",
      "label": "Button Background Color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "btn_text_color",
      "label": "Button Text Color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Arrow Navigation Colors"
    },
    {
      "type": "color",
      "id": "arrow_bg_color",
      "label": "Arrow Button Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "arrow_icon_color",
      "label": "Arrow Icon Color",
      "default": "#111111"
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Desktop Padding Top",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Desktop Padding Bottom",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Mobile Padding Top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Mobile Padding Bottom",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Hero Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "bg_image",
          "label": "Slide Background Image"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle / Badge",
          "default": "NEW FASHION SERIES"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "ELEGANCE REDEFINED"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Experience the next generation of modern fashion with advanced fabrics, sleek couture design, and a comfortable premium fit. Starting from $140."
        },
        {
          "type": "text",
          "id": "btn_label",
          "label": "Button Label",
          "default": "Shop now"
        },
        {
          "type": "url",
          "id": "btn_link",
          "label": "Button Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Fashion Hero Slider",
      "blocks": [
        {
          "type": "slide",
          "settings": {
            "subtitle": "NEW FASHION COLLECTION",
            "heading": "ELEGANCE REDEFINED",
            "description": "Discover our luxury handcrafted fashion collection designed for modern sophistication and supreme comfort. Starting from $140."
          }
        },
        {
          "type": "slide",
          "settings": {
            "subtitle": "AUTUMN / WINTER 2026",
            "heading": "TAILORED LUXURY",
            "description": "Upgrade your wardrobe with sleek silhouettes, fine velvet textures, and statement outer coats. Starting from $180."
          }
        }
      ]
    }
  ]
}
{% endschema %}

{% style %}
  /* Fix horizontal scroll globally for this section */
  html, body {
    max-width: 100% !important;
    overflow-x: hidden !important;
  }

  .section-fashion-hero-slider {
    width: 100% !important;
    max-width: 100% !important;
    margin: 0 !important;
    padding: 0 !important;
    overflow: hidden !important;
  }

  .hero-slider-{{ section.id }} {
    width: 100% !important;
    position: relative;
    box-sizing: border-box;
    overflow: hidden !important;
  }

  /* Break out of standard theme limits smoothly without using 100vw */
  .hero-slider-{{ section.id }} {
    margin-left: calc(-50vw + 50%);
    margin-right: calc(-50vw + 50%);
    width: auto !important;
    max-width: none !important;
  }

  .hero-slider-container {
    max-width: {{ section.settings.content_max_width }}px;
    margin: 0 auto;
    padding: {{ section.settings.padding_top_desktop }}px 40px {{ section.settings.padding_bottom_desktop }}px 40px;
    position: relative;
    min-height: 480px;
    display: flex;
    align-items: center;
    box-sizing: border-box;
    z-index: 2;
  }

  .hero-slides-wrapper {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .hero-single-slide {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    width: 100%;
    position: absolute;
    top: 0;
    left: 0;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.6s cubic-bezier(0.25, 1, 0.5, 1), transform 0.6s cubic-bezier(0.25, 1, 0.5, 1);
    transform: translateY(15px);
    z-index: 1;
  }

  .hero-single-slide.is-active {
    position: relative;
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
    z-index: 2;
  }

  /* Pure Background Image Layer */
  .hero-slide-bg-wrapper {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    pointer-events: none;
  }

  .hero-slide-bg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-size: cover;
    background-position: center center;
    background-repeat: no-repeat;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.6s cubic-bezier(0.25, 1, 0.5, 1);
  }

  .hero-slide-bg.is-active {
    opacity: 1;
    visibility: visible;
  }

  .hero-slide-bg svg.placeholder-svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    fill: #a39b8e;
    background: #e5ded3;
  }

  /* Content Styling */
  .hero-content-left {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    max-width: 650px;
  }

  .hero-subtitle {
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: {{ section.settings.subtitle_color }};
    margin-bottom: 12px;
  }

  .hero-heading {
    font-size: 52px;
    font-weight: 800;
    line-height: 1.15;
    color: {{ section.settings.heading_color }};
    margin: 0 0 20px 0;
    font-family: Georgia, 'Times New Roman', serif;
    letter-spacing: -0.5px;
  }

  .hero-description {
    font-size: 16px;
    line-height: 1.6;
    color: {{ section.settings.desc_color }};
    margin-bottom: 28px;
    opacity: 0.95;
    max-width: 540px;
  }

  .hero-btn {
    display: inline-block;
    background-color: {{ section.settings.btn_bg_color }};
    color: {{ section.settings.btn_text_color }};
    padding: 14px 34px;
    border-radius: 30px;
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  .hero-btn:hover {
    opacity: 0.9;
    transform: translateY(-2px);
  }

  /* Navigation Arrows */
  .hero-fixed-nav {
    position: absolute;
    bottom: 25px;
    right: 40px;
    display: flex;
    align-items: center;
    gap: 12px;
    z-index: 10;
  }

  .hero-nav-btn {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background-color: {{ section.settings.arrow_bg_color }};
    color: {{ section.settings.arrow_icon_color }};
    border: none;
    outline: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.12);
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  .hero-nav-btn:hover {
    transform: scale(1.08);
    opacity: 0.95;
  }

  /* Responsive Adjustments */
  @media screen and (max-width: 900px) {
    .hero-slider-container {
      padding: {{ section.settings.padding_top_mobile }}px 20px {{ section.settings.padding_bottom_mobile }}px 20px;
      min-height: auto;
    }

    .hero-heading {
      font-size: 36px;
    }

    .hero-description {
      font-size: 14px;
    }

    .hero-fixed-nav {
      right: 20px;
      bottom: 15px;
    }

    .hero-nav-btn {
      width: 38px;
      height: 38px;
    }
  }
{% endstyle %}

<div class="hero-slider-{{ section.id }}">
  <!-- Background Images -->
  <div class="hero-slide-bg-wrapper" id="HeroBgs-{{ section.id }}">
    {%- if section.blocks.size > 0 -%}
      {%- for block in section.blocks -%}
        <div class="hero-slide-bg {% if forloop.first %}is-active{% endif %}"
             {% if block.settings.bg_image != blank %}style="background-image: url('{{ block.settings.bg_image | image_url: width: 2000 }}');"{% endif %}
             data-bg-index="{{ forloop.index0 }}">
             {% if block.settings.bg_image == blank %}
               {% assign placeholder_name = 'lifestyle-' | append: forloop.index %}
               {{ placeholder_name | placeholder_svg_tag: 'placeholder-svg' }}
             {% endif %}
        </div>
      {%- endfor -%}
    {%- else -%}
      <div class="hero-slide-bg is-active" data-bg-index="0">
        {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
      </div>
    {%- endif -%}
  </div>

  <div class="hero-slider-container">
    <div class="hero-slides-wrapper" id="HeroSlides-{{ section.id }}">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          <div class="hero-single-slide {% if forloop.first %}is-active{% endif %}" {{ block.shopify_attributes }} data-index="{{ forloop.index0 }}">
            <div class="hero-content-left">
              {%- if block.settings.subtitle != blank -%}
                <span class="hero-subtitle">{{ block.settings.subtitle }}</span>
              {%- endif -%}

              {%- if block.settings.heading != blank -%}
                <h2 class="hero-heading">{{ block.settings.heading }}</h2>
              {%- endif -%}

              {%- if block.settings.description != blank -%}
                <p class="hero-description">{{ block.settings.description }}</p>
              {%- endif -%}

              {%- if block.settings.btn_label != blank -%}
                <a href="{{ block.settings.btn_link | default: '#' }}" class="hero-btn">
                  {{ block.settings.btn_label }}
                </a>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      {%- else -%}
        <div class="hero-single-slide is-active" data-index="0">
          <div class="hero-content-left">
            <span class="hero-subtitle">NEW FASHION SERIES</span>
            <h2 class="hero-heading">ELEGANCE REDEFINED</h2>
            <p class="hero-description">Experience the next generation of modern fashion with advanced fabrics, sleek couture design, and a comfortable premium fit. Starting from $140.</p>
            <a href="#" class="hero-btn">Shop now</a>
          </div>
        </div>
      {%- endif -%}
    </div>

    <!-- Navigation Arrows -->
    <div class="hero-fixed-nav">
      <button type="button" class="hero-nav-btn prev" id="HeroPrev-{{ section.id }}" aria-label="Previous Slide">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
      </button>
      <button type="button" class="hero-nav-btn next" id="HeroNext-{{ section.id }}" aria-label="Next Slide">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </button>
    </div>

  </div>
</div>

<script>
(function() {
  function initHeroSlider(sectionId) {
    const container = document.getElementById('HeroSlides-' + sectionId);
    const bgContainer = document.getElementById('HeroBgs-' + sectionId);
    const prevBtn = document.getElementById('HeroPrev-' + sectionId);
    const nextBtn = document.getElementById('HeroNext-' + sectionId);

    if (!container || !prevBtn || !nextBtn) return;

    const slides = Array.from(container.querySelectorAll('.hero-single-slide'));
    const bgs = bgContainer ? Array.from(bgContainer.querySelectorAll('.hero-slide-bg')) : [];

    if (slides.length <= 1) {
      prevBtn.style.display = 'none';
      nextBtn.style.display = 'none';
      return;
    }

    let currentIndex = 0;

    function showSlide(index) {
      slides.forEach((slide, i) => {
        if (i === index) {
          slide.classList.add('is-active');
        } else {
          slide.classList.remove('is-active');
        }
      });

      bgs.forEach((bg, i) => {
        if (i === index) {
          bg.classList.add('is-active');
        } else {
          bg.classList.remove('is-active');
        }
      });
    }

    nextBtn.addEventListener('click', function() {
      currentIndex = (currentIndex + 1) % slides.length;
      showSlide(currentIndex);
    });

    prevBtn.addEventListener('click', function() {
      currentIndex = (currentIndex - 1 + slides.length) % slides.length;
      showSlide(currentIndex);
    });
  }

  document.addEventListener('DOMContentLoaded', function() {
    initHeroSlider('{{ section.id }}');
  });

  if (window.Shopify && Shopify.designMode) {
    document.addEventListener('shopify:section:load', function(e) {
      if (e.detail.sectionId === '{{ section.id }}') {
        initHeroSlider('{{ section.id }}');
      }
    });
  }
})();
</script>