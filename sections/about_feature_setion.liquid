{% comment %}
  Fashion Features / What We Stand For Section
  File: sections/about_feature_setion.liquid
{% endcomment %}

{%- liquid
  assign sid = section.id
-%}

<style>
  #ff-{{ sid }} {
    width: 100% !important;
    background-color: {{ section.settings.bg_color }};
    padding-top: {{ section.settings.padding_top_desktop }}px;
    padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
    box-sizing: border-box;
  }

  {% if section.settings.enable_full_width %}
    #ff-{{ sid }} {
      width: 100vw !important;
      position: relative !important;
      left: 50% !important;
      right: 50% !important;
      margin-left: -50vw !important;
      margin-right: -50vw !important;
    }
  {% endif %}

  #ff-{{ sid }} .ff-container {
    max-width: {{ section.settings.container_width }}px;
    margin: 0 auto;
    padding: 0 20px;
    width: 100%;
    box-sizing: border-box;
  }

  #ff-{{ sid }} .ff-header {
    text-align: {{ section.settings.heading_alignment }};
    margin-bottom: 40px;
  }

  #ff-{{ sid }} .ff-heading {
    font-family: var(--font-heading--family, inherit);
    font-size: {{ section.settings.heading_size_desktop }}px;
    color: {{ section.settings.heading_color }};
    margin: 0 0 10px 0;
    font-weight: 700;
    line-height: 1.2;
  }

  #ff-{{ sid }} .ff-subheading {
    font-family: var(--font-body--family, inherit);
    font-size: {{ section.settings.subheading_size_desktop }}px;
    color: {{ section.settings.subheading_color }};
    margin: 0;
    line-height: 1.5;
  }

  /* Grid Layout */
  #ff-{{ sid }} .ff-grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);
    gap: {{ section.settings.gap_desktop }}px;
  }

  /* Carousel Layout */
  #ff-{{ sid }} .ff-carousel-wrapper {
    position: relative;
  }

  #ff-{{ sid }} .ff-carousel {
    display: flex;
    gap: {{ section.settings.gap_desktop }}px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    padding-bottom: 10px;
  }

  #ff-{{ sid }} .ff-carousel::-webkit-scrollbar {
    display: none;
  }

  #ff-{{ sid }} .ff-carousel .ff-card {
    flex: 0 0 calc((100% - ({{ section.settings.gap_desktop }}px * ({{ section.settings.columns_desktop }} - 1))) / {{ section.settings.columns_desktop }});
    scroll-snap-align: start;
  }

  /* Card Component Styling */
  #ff-{{ sid }} .ff-card {
    background-color: {{ section.settings.card_bg_color }};
    border-radius: {{ section.settings.card_border_radius }}px;
    padding: {{ section.settings.card_padding_desktop }}px;
    box-shadow: 0 {{ section.settings.card_shadow_y }}px {{ section.settings.card_shadow_blur }}px {{ section.settings.card_shadow_color }};
    border: 1px solid {{ section.settings.card_border_color }};
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    align-items: {{ section.settings.card_content_alignment }};
    text-align: {{ section.settings.card_content_alignment }};
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  #ff-{{ sid }} .ff-card:hover {
    transform: translateY(-4px);
  }

  #ff-{{ sid }} .ff-icon-wrap {
    width: {{ section.settings.icon_size_desktop }}px;
    height: {{ section.settings.icon_size_desktop }}px;
    margin-bottom: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background-color: {{ section.settings.icon_bg_color }};
    color: {{ section.settings.icon_color }};
  }

  #ff-{{ sid }} .ff-icon-wrap svg,
  #ff-{{ sid }} .ff-icon-wrap img {
    width: 50%;
    height: 50%;
    object-fit: contain;
  }

  #ff-{{ sid }} .ff-card-title {
    font-family: var(--font-heading--family, inherit);
    font-size: {{ section.settings.card_title_size_desktop }}px;
    color: {{ section.settings.card_title_color }};
    margin: 0 0 12px 0;
    font-weight: 600;
    line-height: 1.3;
  }

  #ff-{{ sid }} .ff-card-desc {
    font-family: var(--font-body--family, inherit);
    font-size: {{ section.settings.card_desc_size_desktop }}px;
    color: {{ section.settings.card_desc_color }};
    margin: 0;
    line-height: 1.6;
  }

  /* Carousel Navigation Buttons */
  #ff-{{ sid }} .ff-nav-btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: #ffffff;
    color: #111111;
    border: 1px solid #e0e0e0;
    cursor: pointer;
    z-index: 5;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 2px 8px rgba(0,0,0,0.1);
  }

  #ff-{{ sid }} .ff-nav-prev { left: -20px; }
  #ff-{{ sid }} .ff-nav-next { right: -20px; }

  /* Mobile Responsive */
  @media (max-width: 767px) {
    #ff-{{ sid }} {
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }

    #ff-{{ sid }} .ff-container {
      padding: 0 16px;
    }

    #ff-{{ sid }} .ff-heading {
      font-size: {{ section.settings.heading_size_mobile }}px;
    }

    #ff-{{ sid }} .ff-subheading {
      font-size: {{ section.settings.subheading_size_mobile }}px;
    }

    #ff-{{ sid }} .ff-grid {
      grid-template-columns: repeat({{ section.settings.columns_mobile }}, 1fr);
      gap: {{ section.settings.gap_mobile }}px;
    }

    #ff-{{ sid }} .ff-carousel {
      gap: {{ section.settings.gap_mobile }}px;
    }

    #ff-{{ sid }} .ff-carousel .ff-card {
      flex: 0 0 calc((100% - ({{ section.settings.gap_mobile }}px * ({{ section.settings.columns_mobile }} - 1))) / {{ section.settings.columns_mobile }});
    }

    #ff-{{ sid }} .ff-card {
      padding: {{ section.settings.card_padding_mobile }}px;
    }

    #ff-{{ sid }} .ff-icon-wrap {
      width: {{ section.settings.icon_size_mobile }}px;
      height: {{ section.settings.icon_size_mobile }}px;
    }

    #ff-{{ sid }} .ff-card-title {
      font-size: {{ section.settings.card_title_size_mobile }}px;
    }

    #ff-{{ sid }} .ff-card-desc {
      font-size: {{ section.settings.card_desc_size_mobile }}px;
    }

    #ff-{{ sid }} .ff-nav-prev { left: -10px; }
    #ff-{{ sid }} .ff-nav-next { right: -10px; }
  }
</style>

<section id="ff-{{ sid }}" class="ff-section">
  <div class="ff-container">
    
    {% if section.settings.heading != blank or section.settings.subheading != blank %}
      <div class="ff-header">
        {% if section.settings.heading != blank %}
          <h2 class="ff-heading">{{ section.settings.heading }}</h2>
        {% endif %}
        {% if section.settings.subheading != blank %}
          <p class="ff-subheading">{{ section.settings.subheading }}</p>
        {% endif %}
      </div>
    {% endif %}

    {% if section.settings.layout_type == 'carousel' %}
      <div class="ff-carousel-wrapper">
        <button type="button" class="ff-nav-btn ff-nav-prev" id="ff-prev-{{ sid }}" aria-label="Previous">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M15 18l-6-6 6-6"/></svg>
        </button>
        
        <div class="ff-carousel" id="ff-carousel-{{ sid }}">
          {% for block in section.blocks %}
            <div class="ff-card" {{ block.shopify_attributes }}>
              <div class="ff-icon-wrap">
                {% if block.settings.custom_icon != blank %}
                  <img src="{{ block.settings.custom_icon | image_url: width: 100 }}" alt="{{ block.settings.title | escape }}" loading="lazy">
                {% else %}
                  {% case block.settings.icon_type %}
                    {% when 'authenticity' %}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                    {% when 'shipping' %}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
                    {% when 'shield' %}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                    {% when 'cotton' %}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2a10 10 0 100 20 10 10 0 000-20z"/></svg>
                    {% when 'eco' %}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 3v18m9-9H3"/></svg>
                    {% when 'world' %}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15.3 15.3 0 014 10 15.3 15.3 0 01-4 10 15.3 15.3 0 01-4-10 15.3 15.3 0 014-10z"/></svg>
                    {% else %}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/></svg>
                  {% endcase %}
                {% endif %}
              </div>
              {% if block.settings.title != blank %}
                <h3 class="ff-card-title">{{ block.settings.title }}</h3>
              {% endif %}
              {% if block.settings.description != blank %}
                <p class="ff-card-desc">{{ block.settings.description }}</p>
              {% endif %}
            </div>
          {% endfor %}
        </div>

        <button type="button" class="ff-nav-btn ff-nav-next" id="ff-next-{{ sid }}" aria-label="Next">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M9 18l6-6-6-6"/></svg>
        </button>
      </div>
    {% else %}
      <div class="ff-grid">
        {% for block in section.blocks %}
          <div class="ff-card" {{ block.shopify_attributes }}>
            <div class="ff-icon-wrap">
              {% if block.settings.custom_icon != blank %}
                <img src="{{ block.settings.custom_icon | image_url: width: 100 }}" alt="{{ block.settings.title | escape }}" loading="lazy">
              {% else %}
                {% case block.settings.icon_type %}
                  {% when 'authenticity' %}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                  {% when 'shipping' %}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
                  {% when 'shield' %}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                  {% when 'cotton' %}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2a10 10 0 100 20 10 10 0 000-20z"/></svg>
                  {% when 'eco' %}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 3v18m9-9H3"/></svg>
                  {% when 'world' %}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15.3 15.3 0 014 10 15.3 15.3 0 01-4 10 15.3 15.3 0 01-4-10 15.3 15.3 0 014-10z"/></svg>
                  {% else %}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/></svg>
                {% endcase %}
              {% endif %}
            </div>
            {% if block.settings.title != blank %}
              <h3 class="ff-card-title">{{ block.settings.title }}</h3>
            {% endif %}
            {% if block.settings.description != blank %}
              <p class="ff-card-desc">{{ block.settings.description }}</p>
            {% endif %}
          </div>
        {% endfor %}
      </div>
    {% endif %}

  </div>
</section>

{% if section.settings.layout_type == 'carousel' %}
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      const carousel = document.getElementById('ff-carousel-{{ sid }}');
      const prevBtn = document.getElementById('ff-prev-{{ sid }}');
      const nextBtn = document.getElementById('ff-next-{{ sid }}');

      if(carousel && prevBtn && nextBtn) {
        prevBtn.addEventListener('click', () => {
          const cardWidth = carousel.querySelector('.ff-card').offsetWidth;
          carousel.scrollBy({ left: -(cardWidth + 24), behavior: 'smooth' });
        });
        nextBtn.addEventListener('click', () => {
          const cardWidth = carousel.querySelector('.ff-card').offsetWidth;
          carousel.scrollBy({ left: cardWidth + 24, behavior: 'smooth' });
        });
      }
    });
  </script>
{% endif %}

{% schema %}
{
  "name": "Fashion Features",
  "tag": "section",
  "class": "section-fashion-features",
  "settings": [
    {
      "type": "header",
      "content": "Layout Settings"
    },
    {
      "type": "checkbox",
      "id": "enable_full_width",
      "label": "Enable Full Width Section",
      "default": true
    },
    {
      "type": "select",
      "id": "layout_type",
      "label": "Display Type",
      "options": [
        { "value": "grid", "label": "Grid" },
        { "value": "carousel", "label": "Carousel / Slider" }
      ],
      "default": "grid"
    },
    {
      "type": "range",
      "id": "container_width",
      "min": 800,
      "max": 1920,
      "step": 20,
      "unit": "px",
      "label": "Container Max Width",
      "default": 1400
    },
    {
      "type": "header",
      "content": "Desktop Columns & Gap"
    },
    {
      "type": "range",
